#Acral and cutaneous comparison Mexican data
#Data: Mexican data of acral melanoma 
#Raw count data: 5823_2677_Acral_lentigious_melanoma_RNAseq_GRCh38_remap_HTSeq_Sreverse_STAR_ENSv103_ERCC_RAW_frag_counts_sample_supplier_name_IDs.tsv
#Filter samples: rna_scores_sample_data.csv"
#Clinical data and Mutational status: One_per_patient_primaries_intersected_tumor_type_mut_status_all_rna.csv
#Genes:mart_export (15).txt
#Batches for comparison: RNA_batches.csv
#Author: Kenya Lizbeth Contreras Ramírez 

#---Load libraries----
library(DESeq2)
library(dplyr)
library(limma)
library(ggplot2)
library(vegan)

#---Set working directory----
setwd("/results")

#---Load raw counts----
raw_counts <- read.table("/path/data/5823_2677_Acral_lentigious_melanoma_RNAseq_GRCh38_remap_HTSeq_Sreverse_STAR_ENSv103_ERCC_RAW_frag_counts_sample_supplier_name_IDs.tsv", header=TRUE)
rownames(raw_counts) <- raw_counts[,1]
raw_counts <- raw_counts[,-1]

#---Load mutation data---
idfiltrar <- read.csv("/path/data/rna_scores_sample_data.csv")

#---Filter raw counts to selected samples---
raw_counts <- raw_counts[, colnames(raw_counts) %in% idfiltrar$Sample]

#---Load batch info and match order---
batches <- read.csv("/path/data/RNA_batches.csv")
batches <- batches[batches$sample_id %in% idfiltrar$Sample,]
batches <- batches[match(colnames(raw_counts), batches$sample_id),]

#---Create sample table for DESeq2---
sample_table <- data.frame(samplename = colnames(raw_counts), condition = factor(batches$batch_number))

#---Create DESeqDataSet and normalize---
dds <- DESeqDataSetFromMatrix(countData = raw_counts, colData = sample_table, design = ~condition)
dds <- estimateSizeFactors(dds)

#---VST transformation and batch correction---
vsd <- vst(dds, blind=FALSE)
mat <- assay(vsd)
mat_corr <- removeBatchEffect(mat, batch=sample_table$condition)
assay(vsd) <- mat_corr

#---PCA plot with batch-corrected data---
pcadata <- plotPCA(vsd, intgroup = "condition", returnData = TRUE)
percentVar <- round(100 * attr(pcadata, "percentVar"))

ggplot(pcadata, aes(PC1, PC2, color=condition)) +
  geom_point(size=3) +
  stat_ellipse(type="norm", linetype=2, level=0.95, aes(group=condition)) +
  xlab(paste0("PC1: ", percentVar[1], "% variance")) +
  ylab(paste0("PC2: ", percentVar[2], "% variance")) +
  theme_minimal() +
  ggtitle("PCA plot with 95% confidence ellipses by batch") +
  coord_fixed()

#---PERMANOVA & dispersion test---
adonis_result <- adonis2(pcadata[,1:2] ~ condition, data=pcadata, method="euclidean", permutations=999)
print(adonis_result)

d <- dist(pcadata[,1:2])
mod <- betadisper(d, pcadata$condition)
print(permutest(mod))

#---Load genes of interest---
genes <- read.table("/path/data/mart_export (15).txt", sep="\t", header=TRUE)
genes <- subset(genes, Gene.stable.ID != "ENSG00000283060")

# Assign groups
group <- c("C", "A", "C", "A", "A", "A", "C", "A", "A", "C", "C", "A", "C", "C", "C", "A", "A", "C", "A", "C")
genes <- cbind(genes, group=group)

# Subset normalized expression to genes of interest
normalisedsamples <- assay(vsd)[rownames(assay(vsd)) %in% genes$Gene.stable.ID, ]

# Separate by group
cutaneous_genes <- subset(genes, group == "C")
acral_genes <- subset(genes, group == "A")

cutaneoussamples <- normalisedsamples[rownames(normalisedsamples) %in% cutaneous_genes$Gene.stable.ID, ]
acralsamples <- normalisedsamples[rownames(normalisedsamples) %in% acral_genes$Gene.stable.ID, ]

#----Compute product and ratio per sample-----
product_cutaneous <- apply(cutaneoussamples, 2, prod)
product_acral <- apply(acralsamples, 2, prod)
ratio <- product_acral / product_cutaneous

#---Clinical data & mutation filtering---
clinical2 <- dplyr::select(idfiltrar, Sample, BRAF_status, NRAS_status, Mutation_status)

braf <- filter(clinical2, BRAF_status == "Missense")
nras <- filter(clinical2, NRAS_status == "Missense")

braf_values <- ratio[names(ratio) %in% braf$Sample]
wt_braf <- ratio[!(names(ratio) %in% braf$Sample)]

nras_values <- ratio[names(ratio) %in% nras$Sample]
wt_nras <- ratio[!(names(ratio) %in% nras$Sample)]

wtsinnras <- wt_nras[!(names(wt_nras) %in% braf$Sample)]

#---Wilcoxon tests---
wilcox.test(braf_values, wt_braf, alternative = "less")
wilcox.test(braf_values, wtsinnras, alternative = "less")

